      <aliases enabled='yes' />
      <column caption='% Difference' datatype='real' name='[Calculation_141019003037102081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([Calculation_276267729034100751])-sum([YTD Sales (copy)_141019003036278784]))/sum([YTD Sales (copy)_141019003036278784])' />
      </column>
      <column caption='Sales Margin' datatype='string' name='[Calculation_141019003038576642]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if sum([Calculation_276267729034100751])-sum([YTD Sales (copy)_141019003036278784])&lt;0 then &apos;Less Than PY&apos;&#10;ELSEIF sum([Calculation_276267729034100751])-sum([YTD Sales (copy)_141019003036278784])&gt;0 then &apos;Greater Than PY&apos;&#10;elseif ISNULL(sum([YTD Sales (copy)_141019003036278784])) then &apos;No sales in PY&apos;&#10; END' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_141019003043979267]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Positive Diff.' datatype='string' name='[Calculation_141019003044319237]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_141019003037102081]&gt;0 then &apos;▲&apos; end' />
      </column>
      <column caption='Negative Diff' datatype='string' name='[Calculation_141019003045236742]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_141019003037102081]&lt;0 then &apos;▼&apos; end' />
      </column>
      <column caption='No Sales' datatype='string' name='[Calculation_141019003045822471]' role='measure' type='nominal'>
        <calculation class='tableau' formula='If [Calculation_141019003038576642]=&apos;No sales in PY&apos; then &apos;No sales in PY&apos; end' />
      </column>
      <column caption='YTD Quantity LOD' datatype='integer' name='[Calculation_276267728991256576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : sum(if year([Order Date])={MAX(year ([Order Date]))} then[Order Quantity] end)}' />
      </column>
      <column caption='YOY Sales %' datatype='real' name='[Calculation_276267728994598914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([YTD Profit LOD (copy)_276267729026600972]-[YTD Sales LOD (copy)_276267728993939457])/[YTD Sales LOD (copy)_276267728993939457]' />
      </column>
      <column caption='YOY Sales Margin' datatype='string' name='[Calculation_276267728998285315]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_276267728994598914]&gt;0 then&apos;▲&apos; elseif[Calculation_276267728994598914]&lt;0 then&apos;▼&apos;end' />
      </column>
      <column caption='YTD Sales' datatype='real' name='[Calculation_276267729034100751]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if year([Order Date])={max(YEAR([Order Date]))} then [Sales] end' />
      </column>
